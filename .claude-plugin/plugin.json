{
  "name": "artificial-analysis",
  "description": "Get LLM model pricing, speed metrics, and benchmark scores from Artificial Analysis",
  "version": "1.0.0",
  "repository": "https://github.com/davidhariri/artificial-analysis-mcp",
  "category": "ai-tools",
  "mcpServers": {
    "artificial-analysis": {
      "command": "npx",
      "args": ["-y", "artificial-analysis-mcp"],
      "env": {
        "AA_API_KEY": "${AA_API_KEY}"
      }
    }
  }
}
